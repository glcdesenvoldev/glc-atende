# GLC Atende - exemplo sem valores reais
# Copie para .env somente no servidor/ambiente seguro e preencha fora do Git.
# Nunca commitar .env, backups de .env, tokens, senhas, cookies, certificados ou chaves privadas.

# App / runtime
NODE_ENV=
PORT=
NEXT_PUBLIC_APP_URL=
DATA_DIR=

# Dashboard / sessao
DASHBOARD_BASIC_USER=
DASHBOARD_BASIC_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_RESET_EMAILS=
DASHBOARD_RESET_TOKEN_TTL_MINUTES=

# SMTP para reset de senha do dashboard
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# IXC Soft
# Manter usuario API com permissao de leitura enquanto IXC_WRITE_ENABLED nao for aprovado.
IXC_URL=
IXC_TOKEN=
IXC_TIMEOUT_MS=
IXC_WEBHOOK_SECRET=
IXC_CHAMADOS_NOTIFIED_PATH=
IXC_WRITE_ENABLED=
IXC_DEFAULT_USER_ID=

# Monitor interno / rotas protegidas por segredo
MONITOR_SECRET=
AUDIT_LOG_PATH=
AUDIT_LOG_PATH_HOST=

# Telegram interno
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_GROUPS=
TELEGRAM_GROUP_ID=
TELEGRAM_PRIVATE_USERS=
TELEGRAM_RESTRICTED_HOURS_USERS=
TELEGRAM_ATTENDANTS=
TELEGRAM_ACCESS_TIMEZONE=
TELEGRAM_ACCESS_WEEKDAYS=
TELEGRAM_ACCESS_START=
TELEGRAM_ACCESS_END=
TELEGRAM_CHAMADOS_NOTIFY_CHAT_IDS=
TELEGRAM_FINANCE_NOTIFY_CHAT_IDS=
TELEGRAM_EVOLUTION_NOTIFY_CHAT_IDS=
TELEGRAM_WIT_NOTIFY_CHAT_IDS=
TELEGRAM_AUDIT_SUMMARY_CHAT_ID=
TELEGRAM_DAILY_SUMMARY_TARGET=

# Evolution API / WhatsApp
# Manter envio ao cliente bloqueado ate aprovacao humana e regra operacional.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_BILLING_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
BILLING_CADENCE_WHATSAPP_ENABLED=
BILLING_CADENCE_TIMEZONE=
BILLING_CADENCE_WEEKDAYS=
BILLING_CADENCE_START=
BILLING_CADENCE_END=

# Telefones internos / destinos operacionais
TELEFONE_GILSON=
TELEFONE_OLINDO=
ID_TELEGRAM_OLINDO=

# IXC ACS - somente leitura inicialmente
ACS_ENABLED=
ACS_PROVIDER=
ACS_BASE_URL=
ACS_CLIENT_ID=
ACS_CLIENT_SECRET=
ACS_ACCESS_TOKEN=
ACS_PRIVATE_KEY_PEM=
ACS_MODE=
ACS_TIMEOUT_MS=
ACS_AUTH_PATH=
ACS_DEVICE_SEARCH_PATHS=

# WIT/Mundiale monitor
WIT_MONITOR_ENABLED=
WIT_API_BASE=
WIT_OPERATION_ID=
WIT_PROVIDER_ID=
WIT_USER_ID=
WIT_TOKEN_TYPE=
WIT_ACCESS_TOKEN=
WIT_ACCOUNT_ID=
WIT_STORAGE_STATE_PATH=
WIT_ALERT_NEW_TICKETS=
WIT_QUEUE_ALERT_MINUTES=
WIT_ATTENDANCE_ALERT_MINUTES=
WIT_ACTIVE_TICKETS_ALERT_COUNT=
WIT_REPEAT_ALERT_MINUTES=
WIT_MONITOR_TIMEZONE=
WIT_MONITOR_START=
WIT_MONITOR_END=

# WIT/Withub scripts auxiliares
WITHUB_URL=
WITHUB_USER=
WITHUB_PASSWORD=

# Diagnostico financeiro IXC
FINANCE_DIAGNOSTIC_LIMIT=
FINANCE_OVERDUE_ALERT_COUNT=
